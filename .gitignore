# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
files.zip

# temporales y datos personales (auditoría S-09): nunca al repo público
*.tmp.*
myonoesis-*.json
*.xlsx

# Notas de investigación (se publica solo el informe en docs/research)
research_notes/
reports/

# Exportaciones personales (Garmin, etc.): nunca al repo público
*.zip
garmin-export/

# Tabla de alimentos: incluye filas de ARGENFOODS (sin licencia explicita de redistribucion)
docs/research/alimentos-ar.json

# Auditoría A5 (A5S-10): exportaciones de wearables, informes y respaldos renombrados
DI_CONNECT/
*.fit
*.gpx
*.tcx
Activities*.csv
*informe*.pdf
respaldo*.json
